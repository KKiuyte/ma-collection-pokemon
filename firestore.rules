rules_version = '2';

// Règles de sécurité Firestore de « Ma Collection Pokémon ».
//
// ⚠️ Ce fichier N'EST PAS déployé automatiquement (le workflow GitHub ne publie que
//    l'hébergement). Pour l'appliquer : console Firebase → Firestore Database → Règles
//    → coller ce contenu → Publier. (Ou, en local : firebase deploy --only firestore:rules)
//
// Étape 1a du partage : ajout du profil public (pseudo) et du registre des pseudos.
// La collection de chaque personne reste strictement privée.

service cloud.firestore {
  match /databases/{database}/documents {

    // Collection de chaque personne — lecture/écriture réservées à son propriétaire.
    match /collections/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Profil public léger : { pseudo, pseudoLower, email }. Lisible par tout membre
    // connecté (pour retrouver quelqu'un par son pseudo lors du partage à venir),
    // modifiable seulement par son propriétaire.
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Registre des pseudos : garantit l'unicité (clé = pseudo en minuscules) et permet
    // la recherche pseudo -> compte. Un membre ne peut réserver / libérer qu'un pseudo
    // qui pointe vers SON propre compte, ce qui empêche de voler celui d'un autre.
    match /pseudos/{pseudo} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                       && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid;
    }

    // Étape 1b — copies publiées par périmètre (souhaits, échanges). Chaque document
    // appartient à {uid} et n'est lisible que par son propriétaire OU par une personne
    // figurant dans sa liste `viewers`. Seul le propriétaire écrit (data + liste).
    // La collection principale n'est jamais exposée : ces documents ne contiennent que
    // le périmètre partagé (les souhaits, ou la liste des doubles).
    match /shared_wishlist/{uid} {
      allow read:  if request.auth != null
                      && (request.auth.uid == uid || request.auth.uid in resource.data.viewers);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /shared_trades/{uid} {
      allow read:  if request.auth != null
                      && (request.auth.uid == uid || request.auth.uid in resource.data.viewers);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Étape 2 — demandes d'accès : ID2 demande à ID1 de l'autoriser. Identifiant déterministe
    // (propriétaire_demandeur_périmètre), donc un seul document par (demandeur, propriétaire,
    // périmètre) — redemander après un refus écrase simplement l'ancien document.
    // Seul le demandeur écrit sa propre demande ; propriétaire et demandeur peuvent la lire ou
    // la supprimer (accepter/refuser côté propriétaire, annuler côté demandeur).
    // Rapport « et si elle était gradée ? » (2026-09) : écrit UNIQUEMENT par le script
    // tools/psa_collection_value.py via le SDK Admin (compte de service, qui ignore ces
    // règles). Lisible par son seul propriétaire ; aucune écriture possible depuis l'appli.
    match /graded_reports/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /share_requests/{id} {
      allow read: if request.auth != null
                     && (request.auth.uid == resource.data.owner || request.auth.uid == resource.data.requester);
      allow create, update: if request.auth != null
                     && request.auth.uid == request.resource.data.requester
                     && request.resource.data.owner != request.auth.uid;
      allow delete: if request.auth != null
                     && (request.auth.uid == resource.data.owner || request.auth.uid == resource.data.requester);
    }
  }
}
